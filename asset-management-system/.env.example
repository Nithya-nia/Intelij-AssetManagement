# ==============================================================
# Asset Management System - Environment Configuration Example
# ==============================================================

# Backend Server Configuration
SERVER_PORT=8085

# MongoDB Configuration
# Note: Use single-node replica set (rs0) if MongoDB multi-document transactions are enabled
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/asset_management
SPRING_DATA_MONGODB_DATABASE=asset_management

# JWT Authentication Security
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# Initial Admin Credentials (Generated automatically on first startup)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123
APP_ADMIN_FULLNAME=System Administrator
APP_ADMIN_EMAIL=admin@company.com

# Scheduled Task Cron (SIM Expiry check daily at 1:00 AM)
APP_SCHEDULING_SIM_CHECK_CRON=0 0 1 * * ?

# Frontend Configuration
FRONTEND_PORT=4300
API_BASE_URL=http://localhost:8085/api
